{
  "name": "liang-slider",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prepare-sites-build.mjs",
    "build:pages": "tsc --noEmit && vite build --config vite.pages.config.ts --mode github-pages",
    "media:posters": "bash scripts/media/build-posters.sh",
    "media:upload": "bash scripts/media/upload-videos.sh",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@cloudflare/workers-types": "^5.20260813.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "jsdom": "^26.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "number-flow": "^0.6.2"
  }
}

{
  "name": "liang-slider",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node server/start-dev.mjs",
    "dev": "node server/start-dev.mjs",
    "dev:web": "vite",
    "dev:api": "tsx src/server.ts",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --config vite.pages.config.ts --mode github-pages && node scripts/copy-pages-media.mjs",
    "media:posters": "bash scripts/media/build-posters.sh",
    "opencode:models": "tsx scripts/opencode-models.mts",
    "preview": "vite preview",
    "preview:pages": "vite preview --config vite.pages.config.ts --host 127.0.0.1 --port 5173",
    "test:api": "node tests/api-server.mjs",
    "test": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "dompurify": "^3.4.13",
    "marked": "^18.0.9",
    "number-flow": "^0.6.2",
    "opencode-ai": "1.18.16"
  }
}
